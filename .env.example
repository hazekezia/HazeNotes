# HazeNotes environment (all optional; values below are the defaults)
# Copy to .env or export in your deployment environment.

# Set to FALSE to disable authentication entirely (single-user mode)
NOTEPAD_AUTH=TRUE

NOTEPAD_HOST=0.0.0.0
NOTEPAD_PORT=8123

# Storage (SQLite lives inside DATA_DIR; uploaded images in IMAGES_DIR)
NOTEPAD_DATA_DIR=./storage/data
NOTEPAD_IMAGES_DIR=./storage/images

# Session lifetime in hours (default 168 = 7 days)
NOTEPAD_SESSION_TTL_HOURS=168

# Max upload size in bytes (default 20 MB)
NOTEPAD_MAX_UPLOAD_BYTES=20971520

# Login brute-force protection (per IP, per process)
NOTEPAD_LOGIN_RATE_LIMIT=10
NOTEPAD_LOGIN_RATE_WINDOW=300
